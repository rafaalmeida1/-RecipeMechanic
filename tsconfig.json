{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "vitest-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // `scripts/` é ferramenta de migração, corrida à mão com tsx. Fica fora do
  // build para este não depender do cliente Prisma do Postgres, que é gerado
  // localmente e não vai para o repositório. Verifica-se com `pnpm run
  // typecheck:scripts`.
  "exclude": ["node_modules", "scripts"]
}
