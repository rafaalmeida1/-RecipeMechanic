{
  "name": "ribeirocar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "d1:diff": "prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script",
    "d1:apply": "wrangler d1 execute ribeirocar --remote --file",
    "d1:apply:local": "wrangler d1 execute ribeirocar --local --file",
    "d1:generate-pg-client": "prisma generate --schema prisma-postgres/schema.prisma",
    "d1:export": "tsx scripts/d1/export-postgres.ts",
    "d1:import": "tsx scripts/d1/import-d1.ts",
    "d1:verify": "tsx scripts/d1/verify-migration.ts",
    "import:receipts": "tsx scripts/import-legacy-receipts.ts",
    "test": "pnpm run test:vitest && pnpm run test:jest",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:jest": "jest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-pdf/renderer": "^4.3.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.4",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vite": "5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.131.0",
    "xlsx": "^0.18.5"
  }
}
