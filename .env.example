# --- Cloudflare D1 (base de dados da app) ---------------------------------
# A app corre em Node, por isso fala com o D1 pela API REST da Cloudflare.
# O token precisa da permissão "D1:Edit" na conta.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Base D1 de ensaio, usada para o ensaio da migração antes de tocar na real.
# Só é lida pelos scripts, via `--target=CLOUDFLARE_STAGING_DATABASE_ID`.
CLOUDFLARE_STAGING_DATABASE_ID=

# Ficheiro SQLite local. Não é usado em runtime (a ligação vem do adapter) —
# serve ao CLI do Prisma para gerar migrações com `prisma migrate diff`.
DATABASE_URL="file:./dev.db"

# --- PostgreSQL de origem -------------------------------------------------
# Só necessário durante a migração, pelos scripts de `scripts/d1/`.
# Pode ser removido depois de validares a migração.
POSTGRES_URL=

# --- Autenticação ---------------------------------------------------------
AUTH_SECRET=
AUTH_URL=

# --- Email (SMTP) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
EMAIL_FROM=

# --- Opcional -------------------------------------------------------------
# Sem isto o rate limiting fica desligado (ver src/lib/rate-limit.ts).
REDIS_URL=

# Seed inicial (ver prisma/seed.ts).
SEED_USERS=
SEED_BUSINESS_LEGAL_NAME=
SEED_BUSINESS_CNPJ=
SEED_BUSINESS_PHONE=
SEED_BUSINESS_EMAIL=
SEED_BUSINESS_PIX=
